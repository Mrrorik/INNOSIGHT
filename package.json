{
  "name": "innosight",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,demo,web 'npm run dev -w apps/server' 'npm run dev -w apps/demo-api' 'npm run dev -w apps/web'",
    "build": "npm run typecheck && npm run build -w apps/web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "test:unit": "vitest run --exclude tests/integration.test.ts",
    "test:db": "tsx scripts/prepare-test-db.ts",
    "pretest": "npm run test:db",
    "pretest:integration": "npm run test:db",
    "format": "prettier --write apps packages tests scripts docs *.{json,ts,js,yml,md}",
    "format:check": "prettier --check apps packages tests scripts",
    "demo:verify": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.8"
    },
    "eslint": {
      "minimatch": "^11.0.8"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
